{
  "name": "theme-akari",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "晚灯小屋 Akari：温馨、富媒体、具有二次元色彩的 Halo 个人博客主题。",
  "scripts": {
    "dev": "nodemon --config nodemon.json --exec 'pnpm build:promote'",
    "dev:astro": "astro dev",
    "build": "pnpm check && node scripts/package-theme.mjs",
    "build:theme": "astro check && pnpm build:promote",
    "build:astro": "astro build",
    "build:promote": "pnpm build:astro && node scripts/promote-astro-build.mjs",
    "package": "pnpm build",
    "check": "pnpm lint && pnpm build:theme",
    "lint": "eslint 'src/js/**/*.{js,ts}' astro.config.mjs scripts/*.mjs --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "format:astro": "prettier --write 'src/**/*.{astro,vue,ts}' astro.config.mjs scripts/*.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@halo-dev/theme-package-cli": "1.1.1",
    "@iconify-json/lucide": "1.2.149",
    "@iconify-json/simple-icons": "1.2.101",
    "@types/node": "^26.6.6",
    "@unocss/astro": "66.12.0",
    "@unocss/preset-icons": "66.12.0",
    "@unocss/preset-typography": "66.12.0",
    "@unocss/preset-wind4": "66.12.0",
    "@unocss/transformer-variant-group": "66.12.0",
    "eslint": "10.13.0",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "unocss": "66.12.0",
    "astro": "7.4.4",
    "motion": "14.7.1",
    "tocbot": "4.36.8"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "pnpm": {
    "overrides": {
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.17": "3.3.17",
      "sharp@<0.35.0": "0.35.3"
    }
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
