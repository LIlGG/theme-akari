---
import { ClientRouter } from "astro:transitions";
import themeBootstrap from "../js/inline/theme-bootstrap.js?raw";
import "../styles/tokens.css";
import "../styles/foundation/base.css";
import "../styles/shared/shell.css";
import PersistentShell from "../components/shell/PersistentShell.astro";
import SiteFooter from "../components/shell/SiteFooter.astro";
import SiteHeader from "../components/shell/SiteHeader.astro";
import SeoMeta, {
  type Props as SeoMetaProps,
} from "../components/meta/SeoMeta.astro";

interface Props {
  seo?: SeoMetaProps;
}

const { seo } = Astro.props;
---

<!doctype html>
<html
  xmlns:th="https://www.thymeleaf.org"
  th:lang="${#locale.toLanguageTag()}"
  th:with="
    akariPages=${singlePageFinder.list(1,1000).items},
    akariPostsPage=${akariPages.^[spec.template == 'page_posts.html']},
    akariGuestbookPage=${akariPages.^[spec.template == 'page_guestbook.html']},
    akariLinksPage=${akariPages.^[spec.template == 'page_links.html']},
    akariMediaPage=${akariPages.^[spec.template == 'page_media.html']},
    akariCollectionsPage=${akariPages.^[spec.template == 'page_collections.html']},
    akariPostsUrl=${akariPostsPage != null ? akariPostsPage.status.permalink : site.routes.archivesUri},
    akariGuestbookUrl=${akariGuestbookPage != null ? akariGuestbookPage.status.permalink : ''},
    akariAuthorsPath='/authors',
    akariFeedPath='/rss.xml',
    akariLinksPath='/links',
    akariMomentsPath='/moments',
    akariPhotosPath='/photos',
    akariSearchPath='/search'
  "
  th:attr="
    data-default-theme=${theme.config.appearance.color_scheme},
    data-image-error-label=#{media.unavailable},
    data-audio-error-label=#{media.error},
    data-table-scroll-label=#{post.tableScroll},
    data-template-id=${_templateId}
  "
  th:style="|--akari-accent-source:${theme.config.appearance.accent_color ?: '#b94363'}|"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#fff8f0"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#211a22"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="generator" content="Halo" />
    <link
      th:if="${not #strings.isEmpty(site.favicon)}"
      rel="icon"
      th:href="@{${site.favicon}}"
    />
    <link
      th:unless="${not #strings.isEmpty(site.favicon)}"
      rel="icon"
      type="image/svg+xml"
      th:href="${#theme.assets('/images/akari-logo.svg')}"
    />
    <slot name="head">
      <title th:text="${site.title}">Akari</title>
    </slot>
    <SeoMeta {...seo} />
    <ClientRouter fallback="animate" />
    <script is:inline set:html={themeBootstrap} />
    <script src="../js/app.ts"></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content" th:text="#{site.skip}">Skip</a>

    <SiteHeader />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />
    <PersistentShell />
  </body>
</html>
