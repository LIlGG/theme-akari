<section
  class="article-comments moment-comments"
  id="moment-comments"
  th:if="${haloCommentEnabled}"
  data-akari-article-comments
  data-comment-group="moment.halo.run"
  data-comment-version="v1alpha1"
  data-comment-kind="Moment"
  th:data-comment-name="${moment.metadata.name}"
  th:data-comment-enabled="${haloCommentEnabled}"
  th:data-comment-plugin="${pluginFinder.available('PluginCommentWidget')}"
  th:data-message-limit="${theme.config.content.article_comment_limit ?: 800}"
  th:data-label-write="#{moment.commentWrite}"
  th:data-label-close-composer="#{moment.commentCloseComposer}"
  th:data-label-empty="#{moment.commentEmpty}"
  th:data-label-upvote="#{post.commentUpvote}"
  th:data-label-reply="#{post.commentReply}"
  th:data-label-close-reply="#{post.commentCloseReply}"
  th:data-label-replies="#{post.commentReplies}"
  th:data-label-submit-reply="#{post.commentSubmitReply}"
  th:data-label-reply-placeholder="#{moment.commentReplyPlaceholder}"
  th:data-label-load-error="#{moment.commentLoadError}"
  th:data-label-submit-success="#{moment.commentSubmitSuccess}"
  th:data-label-submit-pending="#{moment.commentSubmitPending}"
  th:data-label-submit-error="#{moment.commentSubmitError}"
  th:data-label-name-required="#{post.commentNameRequired}"
  th:data-label-email-required="#{post.commentEmailRequired}"
  th:data-label-email-invalid="#{post.commentEmailInvalid}"
  th:data-label-website-invalid="#{post.commentWebsiteInvalid}"
  th:data-label-message-required="#{post.commentMessageRequired}"
  th:data-label-reviewing="#{post.commentReviewing}"
  th:data-label-pinned="#{post.commentPinned}"
  th:data-label-no-replies="#{post.commentNoReplies}"
  th:data-label-captcha-required="#{post.commentCaptchaRequired}"
  th:data-label-login-required="#{post.commentLoginRequired}"
>
  <div class="section-heading article-comments-heading moment-comments-heading">
    <div>
      <p class="kicker"><span data-article-comment-total>0</span> ECHOES</p>
      <h2 th:text="#{moment.comments}">这一刻的回声</h2>
      <p class="article-comments-subtitle" th:text="#{moment.commentSubtitle}">
        把路过这一刻的心情，轻轻留在这里。
      </p>
    </div>
    <button
      class="text-button article-comment-compose-toggle"
      type="button"
      data-article-comment-compose-toggle
      aria-controls="moment-comment-composer"
      aria-expanded="false"
    >
      <span class="i-lucide-message-circle-heart"></span>
      <span data-compose-toggle-label th:text="#{moment.commentWrite}"
        >回应这一刻</span
      >
      <span class="i-lucide-arrow-down article-compose-chevron"></span>
    </button>
  </div>

  <form
    class="article-comment-composer moment-comment-composer"
    id="moment-comment-composer"
    data-article-comment-form
    novalidate
    hidden
  >
    <div class="article-comment-composer-mark" aria-hidden="true">
      <span class="i-lucide-sparkles"></span>
    </div>
    <div class="article-comment-composer-copy">
      <div class="article-comment-composer-title">
        <div>
          <strong th:text="#{moment.commentComposerTitle}"
            >在片刻背面留字</strong
          >
          <small th:text="#{moment.commentComposerHint}"
            >回应会留在这条瞬间下面，并遵循本站的审核规则。</small
          >
        </div>
        <span class="article-comment-stamp">MOMENT NOTE</span>
      </div>

      <label class="article-comment-name-field">
        <span th:text="#{guestbook.displayName}">你的称呼</span>
        <input
          type="text"
          maxlength="48"
          autocomplete="nickname"
          data-article-comment-name
          th:placeholder="#{post.commentNamePlaceholder}"
          required
        />
      </label>

      <div
        class="article-comment-guest-fields"
        data-article-comment-guest-fields
      >
        <label>
          <span th:text="#{guestbook.email}">邮箱</span>
          <input
            type="email"
            maxlength="254"
            autocomplete="email"
            data-article-comment-email
            th:placeholder="#{guestbook.emailPlaceholder}"
            required
          />
        </label>
        <label>
          <span th:text="#{guestbook.website}">个人站点（可选）</span>
          <input
            type="url"
            maxlength="2048"
            autocomplete="url"
            data-article-comment-website
            th:placeholder="#{guestbook.websitePlaceholder}"
          />
        </label>
      </div>

      <label class="article-comment-message-field">
        <span th:text="#{moment.commentMessage}">此刻想说的话</span>
        <textarea
          rows="5"
          th:maxlength="${theme.config.content.article_comment_limit ?: 800}"
          data-article-comment-message
          th:placeholder="#{moment.commentMessagePlaceholder}"
          required></textarea>
        <small data-article-comment-counter>0 / 800</small>
      </label>

      <div
        class="article-comment-captcha comment-captcha-panel"
        data-article-comment-captcha
        role="group"
        aria-labelledby="moment-comment-captcha-title"
        hidden
      >
        <div class="comment-captcha-intro">
          <span class="comment-captcha-mark" aria-hidden="true">
            <span class="i-lucide-shield-check"></span>
          </span>
          <span>
            <strong
              id="moment-comment-captcha-title"
              th:text="#{guestbook.captchaTitle}">访客校验</strong
            >
            <small th:text="#{guestbook.captchaHint}">点击图片可以换一张</small>
          </span>
        </div>
        <div class="comment-captcha-controls">
          <button
            class="comment-captcha-image"
            type="button"
            data-article-captcha-refresh
            th:aria-label="#{guestbook.refreshCaptcha}"
          >
            <img data-article-captcha-image data-runtime-image alt="" />
            <span class="i-lucide-refresh-cw" aria-hidden="true"></span>
          </button>
          <label class="comment-captcha-field">
            <span th:text="#{guestbook.captcha}">验证码</span>
            <input
              type="text"
              inputmode="text"
              autocomplete="off"
              data-article-captcha-code
              th:placeholder="#{guestbook.captchaPlaceholder}"
            />
          </label>
        </div>
      </div>

      <div class="article-comment-composer-footer">
        <p>
          <span class="i-lucide-shield-check"></span><span
            th:text="#{post.commentPrivacy}"
            >只保存回应所需信息，不公开额外资料。</span
          >
        </p>
        <button
          class="primary-button"
          type="submit"
          data-article-comment-submit
        >
          <span class="i-lucide-send"></span><span
            th:text="#{moment.commentSubmit}">寄出回声</span
          >
        </button>
      </div>
      <div
        class="article-comment-state"
        data-article-comment-state
        aria-live="polite"
      >
      </div>
    </div>
  </form>

  <div
    class="article-response-grid"
    data-article-comment-list
    aria-live="polite"
    aria-busy="true"
  >
    <div class="article-response-skeleton" aria-hidden="true"></div>
    <div class="article-response-skeleton" aria-hidden="true"></div>
  </div>

  <button
    class="article-comment-load-more"
    type="button"
    data-article-comment-load-more
    hidden
  >
    <span class="i-lucide-message-circle-more"></span>
    <span th:text="#{moment.commentLoadMore}">再听几段回声</span>
    <span class="i-lucide-arrow-down"></span>
  </button>

  <div
    class="article-comment-toast"
    data-article-comment-toast
    role="status"
    aria-live="polite"
    hidden
  >
  </div>
</section>
